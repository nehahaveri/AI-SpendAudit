# Verdict — environment variables (copy to .env.local; never commit real values)

# Public base URL of the deployed site (used for OG tags + share links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI summary (Anthropic). The summary module falls back to a template if unset/failing.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Storage (Supabase) — server-side only.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx

# Transactional email (Resend).
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM="Verdict <audit@yourdomain.com>"

# Where high-savings lead alerts are sent internally.
CREDEX_NOTIFY_EMAIL=team@credex.example
