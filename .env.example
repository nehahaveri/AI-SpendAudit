# Verdict — environment variables (copy to .env.local per service; never commit real values)
# Each microservice reads only the vars it owns.

# ── services/web (Next.js BFF) ───────────────────────────────────────────────
# Public base URL of the deployed site (used for OG tags + share links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Internal URLs the web BFF uses to reach the backend services.
ENGINE_URL=http://localhost:4001
SUMMARY_URL=http://localhost:4002
LEADS_URL=http://localhost:4003

# ── services/engine ──────────────────────────────────────────────────────────
# Stateless; no secrets. Port only.
# PORT=4001

# ── services/summary (Anthropic) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# PORT=4002

# ── services/leads (Supabase + Resend) ───────────────────────────────────────
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM="Verdict <audit@yourdomain.com>"
# Where high-savings lead alerts are sent internally.
CREDEX_NOTIFY_EMAIL=team@credex.example
# PORT=4003
